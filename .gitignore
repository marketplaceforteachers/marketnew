# Real credentials — install.php writes this from config.php.example; never commit it.
config.php

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# User-uploaded images (avatars, blog) — real content only ever exists on the live server,
# never in the repo. .htaccess/.gitkeep are tracked so the directories and their protection
# ship with a fresh checkout; the images themselves are not.
uploads/avatars/*
!uploads/avatars/.gitkeep
uploads/blog/*
!uploads/blog/.gitkeep
